{
  "openapi": "3.1.0",
  "info": {
    "title": "Meteroid Client API",
    "description": "Browser-facing API. The customer's own routes are authenticated with a customer portal token; the public routes (pricing pages) with a publishable key (`pk_…`). It follows API v2's conventions: snake_case, prefixed ids, lists paged by cursor (`?limit=&after=`), errors as RFC 9457 problems (`application/problem+json`), and `Meteroid-Version: YYYY-MM-DD` to pin a version.",
    "license": {
      "name": "AGPL-3.0-only",
      "identifier": "AGPL-3.0-only"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/client/v1/customer": {
      "get": {
        "tags": [
          "Customer"
        ],
        "summary": "Get the customer",
        "description": "The customer the token was minted for.",
        "operationId": "get_customer",
        "responses": {
          "200": {
            "description": "Customer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientCustomer"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_expired`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token does not grant read access",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Customer not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "customer_token": []
          }
        ],
        "x-meteroid-edition": "oss"
      }
    },
    "/api/client/v1/entitlements": {
      "get": {
        "tags": [
          "Entitlements"
        ],
        "summary": "List entitlements",
        "description": "Every feature the customer is entitled to, with live usage, in feature order and paged by\ncursor: the customer's entitlements as API v2 reads them.",
        "operationId": "list_entitlements",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "How many items, 1 to 100; 20 by default.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "The `next_cursor` of the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the customer's entitlements",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CustomerEntitlementList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_expired`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token does not grant read access",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The cursor or limit is refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "customer_token": []
          }
        ],
        "x-meteroid-edition": "oss"
      }
    },
    "/api/client/v1/pricing-pages/{family_code}": {
      "get": {
        "tags": [
          "Pricing pages"
        ],
        "summary": "Get a pricing page",
        "description": "A product family's pricing page, as API v2's `GET /api/v2/pricing-pages/{family_code}` reads\nit: its self-serve ladder priced in one currency and one option, card by card. Only what the\npublic page shows: a sales-led plan's hidden price is left out. Authenticated with a\npublishable key, from one of its allowed origins when it lists any.",
        "operationId": "get_pricing_page",
        "parameters": [
          {
            "name": "family_code",
            "in": "path",
            "description": "Product family code (or id)",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "description": "A currency the ladder is sold in; the default when left out or not sold in.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "option",
            "in": "query",
            "description": "An option alias of the page's switch; the first when left out or not on it.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The pricing page",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PricingPage"
                }
              }
            }
          },
          "304": {
            "description": "Unchanged since the `ETag` sent in `If-None-Match`"
          },
          "401": {
            "description": "Missing or unknown publishable key, or another credential",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The key is not accepted from the request's origin",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "No such product family",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "publishable_key": []
          }
        ],
        "x-meteroid-edition": "oss"
      }
    },
    "/api/client/v1/subscriptions": {
      "get": {
        "tags": [
          "Subscriptions"
        ],
        "summary": "List subscriptions",
        "description": "The customer's current subscriptions in creation order, paged by cursor; cancelled, completed\nand aborted ones are left out. Each reads as API v2's summary of a subscription.",
        "operationId": "list_subscriptions",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "How many items, 1 to 100; 20 by default.",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "after",
            "in": "query",
            "description": "The `next_cursor` of the previous page.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A page of the customer's subscriptions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClientSubscriptionList"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid or expired token (`token_expired`)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "The token does not grant read access",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "The cursor or limit is refused",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Too many requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        },
        "security": [
          {
            "customer_token": []
          }
        ],
        "x-meteroid-edition": "oss"
      }
    }
  },
  "components": {
    "schemas": {
      "AtLimit": {
        "type": "string",
        "description": "What reaching the limit does: refuse (past `grace_pct` percent more), or let usage go on.",
        "enum": [
          "block",
          "allow"
        ]
      },
      "BillableMetricId": {
        "type": "string",
        "format": "MeteroidId",
        "examples": [
          "bm_7n42DGM5Tflk9n8mt7Fhc7"
        ]
      },
      "BillingCycleReset": {
        "type": "object",
        "description": "At each renewal of the subscription.",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "billing_cycle"
            ]
          }
        },
        "additionalProperties": false
      },
      "BooleanEntitlement": {
        "type": "object",
        "description": "On or off.",
        "required": [
          "enabled",
          "type"
        ],
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "type": {
            "type": "string",
            "enum": [
              "boolean"
            ]
          }
        }
      },
      "Cadence": {
        "type": "string",
        "description": "How often a price bills. Usage and one-time prices read their usage or fee whatever it is.",
        "enum": [
          "monthly",
          "quarterly",
          "semiannual",
          "annual"
        ]
      },
      "CalendarReset": {
        "type": "object",
        "description": "On calendar boundaries (the 1st of each month…), every `interval` calendar `unit`s.",
        "required": [
          "unit",
          "interval",
          "type"
        ],
        "properties": {
          "interval": {
            "type": "integer",
            "format": "int32",
            "description": "At least 1.",
            "minimum": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "calendar"
            ]
          },
          "unit": {
            "$ref": "#/components/schemas/Unit"
          }
        },
        "additionalProperties": false
      },
      "CardExtra": {
        "type": "object",
        "description": "An item of a card, in the order it reads.",
        "required": [
          "kind",
          "name",
          "from_lowest",
          "lead"
        ],
        "properties": {
          "amount": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal"
          },
          "block_size": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "description": "`amount` is per this many units.",
            "minimum": 0
          },
          "from_lowest": {
            "type": "boolean",
            "description": "`amount` is the lowest rate of its tiers."
          },
          "included": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64",
            "minimum": 0
          },
          "kind": {
            "$ref": "#/components/schemas/ExtraKind"
          },
          "lead": {
            "type": "boolean",
            "description": "The card's price: the others read beside it."
          },
          "name": {
            "type": "string",
            "description": "The charge's name; empty for the base price."
          },
          "period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cadence"
              },
              {
                "type": "null"
              }
            ]
          },
          "unit": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CardLevel": {
        "type": "object",
        "required": [
          "included",
          "amount"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "format": "decimal"
          },
          "included": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "monthly_equivalent": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal"
          },
          "overage_rate": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal"
          }
        }
      },
      "CardLevels": {
        "type": "object",
        "description": "The usage levels a visitor picks between.",
        "required": [
          "name",
          "levels"
        ],
        "properties": {
          "levels": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardLevel"
            }
          },
          "metric_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "more": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/LevelsMore"
              },
              {
                "type": "null"
              }
            ]
          },
          "name": {
            "type": "string"
          },
          "unit_plural": {
            "type": [
              "string",
              "null"
            ]
          },
          "unit_singular": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "CardPrice": {
        "type": "object",
        "required": [
          "amount",
          "from_lowest",
          "partial",
          "extras"
        ],
        "properties": {
          "amount": {
            "type": "string",
            "format": "decimal"
          },
          "extras": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardExtra"
            }
          },
          "from_lowest": {
            "type": "boolean",
            "description": "The amount is the lowest of several levels: \"from\"."
          },
          "levels": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/CardLevels"
              },
              {
                "type": "null"
              }
            ]
          },
          "monthly_equivalent": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal"
          },
          "partial": {
            "type": "boolean",
            "description": "A charge could not be shown: never read as free."
          },
          "period": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Cadence",
                "description": "None for a plan billing only usage or one-time charges."
              },
              {
                "type": "null"
              }
            ]
          },
          "saving_percent": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int32",
            "minimum": 0
          }
        }
      },
      "ClientCustomer": {
        "type": "object",
        "description": "The customer the token was minted for: who it is, as v2 reads a customer.",
        "required": [
          "id",
          "type",
          "name",
          "currency"
        ],
        "properties": {
          "alias": {
            "type": [
              "string",
              "null"
            ],
            "description": "The merchant's own id of the customer."
          },
          "currency": {
            "type": "string",
            "description": "What the customer is billed in (ISO 4217)."
          },
          "email": {
            "type": [
              "string",
              "null"
            ],
            "description": "The billing email."
          },
          "first_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "$ref": "#/components/schemas/CustomerId"
          },
          "last_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "description": "A company's name, or a person's full name."
          },
          "type": {
            "$ref": "#/components/schemas/CustomerKind"
          }
        }
      },
      "ClientPlanRef": {
        "type": "object",
        "description": "The plan a subscription is on, by code, with its name to show.",
        "required": [
          "code",
          "name",
          "version"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "option": {
            "type": [
              "string",
              "null"
            ],
            "description": "The option bought, by alias; none for a subscription older than options."
          },
          "version": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "ClientSubscription": {
        "type": "object",
        "description": "A subscription of the customer, as v2's summary reads it (`GET\n/api/v2/subscriptions/{id}/summary`), less what only the merchant reads: its MRR, invoicing,\ncustom properties, usage filter and external id.",
        "required": [
          "id",
          "plan",
          "status",
          "currency",
          "period",
          "dates",
          "current_period"
        ],
        "properties": {
          "currency": {
            "type": "string"
          },
          "current_period": {
            "$ref": "#/components/schemas/CurrentPeriod"
          },
          "dates": {
            "$ref": "#/components/schemas/Dates"
          },
          "id": {
            "$ref": "#/components/schemas/SubscriptionId"
          },
          "period": {
            "$ref": "#/components/schemas/Cadence",
            "description": "How often it renews."
          },
          "plan": {
            "$ref": "#/components/schemas/ClientPlanRef"
          },
          "status": {
            "$ref": "#/components/schemas/SubscriptionStatus"
          },
          "trial": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/TrialState"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "ClientSubscriptionList": {
        "type": "object",
        "required": [
          "data",
          "has_more"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ClientSubscription"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass it as `after` for the next page; none on the last."
          }
        }
      },
      "ConfigEntitlement": {
        "type": "object",
        "description": "A setting: a number (as a decimal string), a boolean, a text or a JSON value.",
        "required": [
          "value",
          "type"
        ],
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "config"
            ]
          },
          "value": {}
        }
      },
      "CurrentPeriod": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "Exclusive; none for a subscription not billed by period yet."
          },
          "start": {
            "type": "string",
            "format": "date"
          }
        }
      },
      "CustomerEntitlement": {
        "type": "object",
        "description": "What the customer may use of one feature.",
        "required": [
          "feature",
          "name",
          "value"
        ],
        "properties": {
          "feature": {
            "$ref": "#/components/schemas/FeatureRef"
          },
          "name": {
            "type": "string",
            "description": "The feature's name."
          },
          "product": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/ProductRef",
                "description": "The product the feature belongs to; none for a feature of the whole catalog."
              },
              {
                "type": "null"
              }
            ]
          },
          "value": {
            "$ref": "#/components/schemas/EntitlementValue"
          }
        }
      },
      "CustomerEntitlementList": {
        "type": "object",
        "required": [
          "data",
          "has_more"
        ],
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerEntitlement"
            }
          },
          "has_more": {
            "type": "boolean"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "description": "Pass it as `after` for the next page; none on the last."
          }
        }
      },
      "CustomerId": {
        "type": "string",
        "format": "MeteroidId",
        "examples": [
          "cus_7n42DGM5Tflk9n8mt7Fhc7"
        ]
      },
      "CustomerKind": {
        "type": "string",
        "description": "A company, or a person (B2C): a person is named by `first_name` and `last_name`, and needs a\nbilling country.",
        "enum": [
          "company",
          "individual"
        ]
      },
      "Dates": {
        "type": "object",
        "required": [
          "start"
        ],
        "properties": {
          "activated_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "billing_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "When it is billed from: its start, after a free trial."
          },
          "end": {
            "type": [
              "string",
              "null"
            ],
            "format": "date",
            "description": "When it ends; none: until cancelled."
          },
          "ended_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "When it ended (cancelled, completed)."
          },
          "start": {
            "type": "string",
            "format": "date",
            "description": "When its benefits start, a trial included."
          }
        }
      },
      "EntitlementUsage": {
        "type": "object",
        "properties": {
          "consumed": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "description": "Counted in the current window; none when the usage could not be read."
          },
          "period_start": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "remaining": {
            "type": [
              "string",
              "null"
            ],
            "format": "decimal",
            "description": "Left under the limit."
          },
          "reset_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      },
      "EntitlementValue": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/BooleanEntitlement"
          },
          {
            "$ref": "#/components/schemas/MeteredEntitlement"
          },
          {
            "$ref": "#/components/schemas/ConfigEntitlement"
          }
        ],
        "discriminator": {
          "propertyName": "type",
          "mapping": {
            "boolean": "#/components/schemas/BooleanEntitlement",
            "config": "#/components/schemas/ConfigEntitlement",
            "metered": "#/components/schemas/MeteredEntitlement"
          }
        }
      },
      "ExtraKind": {
