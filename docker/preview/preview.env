# Preview environment defaults for the all-in-one `standalone` binary.
# Dev-only secrets (safe to commit). NOT for production. An optional license.env
# next to this file adds settings on top, such as a license key.
#
# Public-facing URLs (METEROID_PUBLIC_URL / *_EXTERNAL_URL / VITE_*) are NOT set
# here — they are wired in docker-compose.yml so Coolify can inject the generated
# preview domains. Everything below is container-network / degraded-mode config.

## Platform secrets
JWT_SECRET=changeMeSecret
INTERNAL_API_SECRET=changeMeSecret
SECRETS_CRYPT_KEY=00000000000000000000000000000000

## Listen addresses (bind on all interfaces inside the container)
METEROID_API_LISTEN_ADDRESS=0.0.0.0:50061
METEROID_REST_API_LISTEN_ADDRESS=0.0.0.0:8084

## Metering (disabled in the fast preview build — points at the in-process
## address, never reached in degraded mode; still required by config).
METERING_API_LISTEN_ADDRESS=0.0.0.0:50062
METERING_API_EXTERNAL_URL=http://127.0.0.1:50062
KAFKA_RAW_TOPIC=meteroid-events-raw

## Database — resolves to the meteroid-db service on the compose network
DATABASE_USER=meteroid
DATABASE_PASSWORD=secret
DATABASE_NAME=meteroid
DATABASE_URL=postgres://meteroid:secret@meteroid-db:5432/meteroid?sslmode=disable

## Rate limiting
RATE_LIMIT_GRPC_RPM=100000

## Object store — ephemeral local filesystem (no volume needed for previews)
OBJECT_STORE_URI=file:///tmp/meteroid/object-store

## Telemetry off
TELEMETRY_TRACING_ENABLED=false
TELEMETRY_METRICS_ENABLED=false

## Development
DEBUG=false
