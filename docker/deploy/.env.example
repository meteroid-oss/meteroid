# Meteroid Deploy Configuration
# Copy this file to .env and configure the values below

## Images: the latest release by default. To stay on one release, set its version (x.y.z).
# METEROID_VERSION=

## Required Secrets (change these!)
JWT_SECRET=changeMeToASecureRandomString
INTERNAL_API_SECRET=changeMeToASecureRandomString
# Exactly 32 characters (openssl rand -hex 16). Set it before the first start and never change
# it: it encrypts the connector credentials stored in the database.
SECRETS_CRYPT_KEY=00000000000000000000000000000000

## Database
DATABASE_USER=meteroid
DATABASE_PASSWORD=changeMeToASecurePassword
DATABASE_NAME=meteroid

## Redis (optional, state shared across replicas)
# API rate limits are counted here; without REDIS_URL, none apply.
# REDIS_URL=redis://redis:6379
# REDIS_PASSWORD=

## ClickHouse
CLICKHOUSE_DATABASE=meteroid
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=default
CLICKHOUSE_CLUSTER_NAME=meteroid

## Kafka
KAFKA_RAW_TOPIC=meteroid-events-raw

## Object Storage (default: filesystem with persistent volume, can use S3)
# OBJECT_STORE_URI=file:///data/object-store
# For S3:
# OBJECT_STORE_URI=s3://meteroid
# AWS_ALLOW_HTTP=true
# AWS_ENDPOINT=http://minio:9000
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

## Public URLs (used by the web frontend)
VITE_METEROID_API_EXTERNAL_URL=http://localhost:50061
VITE_METEROID_REST_API_EXTERNAL_URL=http://localhost:8084
METEROID_PUBLIC_URL=http://localhost:3000

# METEROID_MFA_ISSUER=Meteroid

## Multi-organization mode
ENABLE_MULTI_ORGANIZATION=false

## Outbound webhooks (native delivery, no external dependency)
# Like the other optional settings, each needs its line uncommented in docker-compose.yml.
# Private addresses and plain http are refused by default (webhooks, alerts and SSO). Set to
# true to deliver to receivers inside your own network.
# WEBHOOK_ALLOW_PRIVATE_DESTINATIONS=false
# WEBHOOK_DELIVERY_CONCURRENCY=32
# CONNECT egress proxy webhook and alert traffic is sent through (e.g. for fixed IPs).
# While it is down, deliveries wait without counting against their endpoints.
# WEBHOOK_EGRESS_PROXY_URL=
# Also send SSO through it; off so logins never depend on the proxy.
# EGRESS_USE_PROXY_SSO=false
# Minimum 2 (a delivery's retry ladder spans about 28 hours).
# WEBHOOK_RETENTION_DAYS=30

## Optional: OAuth
# OAUTH_GOOGLE_CLIENT_ID=
# OAUTH_GOOGLE_CLIENT_SECRET=

## Optional: SMTP Mail
# MAILER_SMTP_HOST=smtp.example.com
# MAILER_SMTP_USERNAME=
# MAILER_SMTP_PASSWORD=
# MAILER_SMTP_TLS=true
# Sender of account and alert emails; required once MAILER_SMTP_HOST is set.
# MAILER_FROM=Billing <billing@example.com>
# Address customer emails are sent from, behind each invoicing entity's sender name.
# Defaults to the address of MAILER_FROM.
# MAILER_CUSTOMER_FROM_ADDR=billing@example.com
# Reply-To of account and alert emails; none by default.
# MAILER_REPLY_TO=No Reply <no-reply@example.com>

## Optional: Telemetry (OpenTelemetry)
TELEMETRY_TRACING_ENABLED=false
TELEMETRY_METRICS_ENABLED=false
# TELEMETRY_OTEL_ENDPOINT=http://otel-collector:4317
