<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <h1 class="h1" style="margin:0;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-0.3px;color:#111318;"><%= severity %> &middot; <%= alert_name %></h1>
      <p style="margin:12px 0 0;font-size:15px;line-height:24px;color:#414651;">An alert you configured has just fired.</p>
    </td>
  </tr>
  <tr>
    <td style="padding-top:24px;">
      <table role="presentation" class="summary" width="100%" cellpadding="0" cellspacing="0" border="0" bgcolor="#f7f8fa" style="width:100%;border-collapse:separate;background-color:#f7f8fa;border:1px solid #e8eaee;border-radius:12px;">
        <tr>
          <td class="panel-pad" style="padding:14px 24px;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
              <tr>
                <td valign="top" style="padding:6px 16px 6px 0;font-size:14px;line-height:20px;color:#6b7079;">Alert</td>
                <td valign="top" align="right" style="padding:6px 0;font-size:14px;line-height:20px;font-weight:500;color:#111318;text-align:right;"><%= alert_name %></td>
              </tr>
              <tr>
                <td valign="top" style="padding:6px 16px 6px 0;font-size:14px;line-height:20px;color:#6b7079;">Metric</td>
                <td valign="top" align="right" style="padding:6px 0;font-size:14px;line-height:20px;font-weight:500;color:#111318;text-align:right;"><%= metric_key %></td>
              </tr>
              <tr>
                <td valign="top" style="padding:6px 16px 6px 0;font-size:14px;line-height:20px;color:#6b7079;">Severity</td>
                <td valign="top" align="right" style="padding:6px 0;font-size:14px;line-height:20px;font-weight:500;color:#111318;text-align:right;"><%= severity %></td>
              </tr>
              <tr>
                <td valign="top" style="padding:6px 16px 6px 0;font-size:14px;line-height:20px;color:#6b7079;">Date</td>
                <td valign="top" align="right" style="padding:6px 0;font-size:14px;line-height:20px;font-weight:500;color:#111318;text-align:right;"><%= window_date %></td>
              </tr>
            </table>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td>
      <p style="margin:20px 0 0;font-size:15px;line-height:24px;color:#414651;"><%= summary %></p>
    </td>
  </tr>
  <tr>
    <td style="padding-top:28px;">
      <table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="button" align="center" bgcolor="#111318" style="border-radius:8px;background-color:#111318;mso-padding-alt:12px 24px;">
            <a href="<%= alerts_url %>" target="_blank" style="display:inline-block;padding:12px 24px;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;">View alert details</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding-top:20px;">
      <p style="margin:0;font-size:13px;line-height:20px;color:#6b7079;">Or copy and paste this link: <a href="<%= alerts_url %>" target="_blank" style="color:#414651;text-decoration:underline;word-break:break-all;"><%= alerts_url %></a></p>
    </td>
  </tr>
</table>
