<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <h1 class="h1" style="margin:0;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-0.3px;color:#111318;"><%= heading %></h1>
    </td>
  </tr>
  <tr>
    <td style="padding-top:28px;">
      <%+ summary %>
    </td>
  </tr>
<% if let Some(message) = custom_message { %>
  <tr>
    <td style="padding-top:24px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="custom-message" style="padding:2px 0 2px 16px;border-left:3px solid #e2e4e9;font-size:15px;line-height:24px;color:#414651;white-space:pre-wrap;"><%= message %></td>
        </tr>
      </table>
    </td>
  </tr>
<% } %>
  <tr>
    <td style="padding-top:28px;">
      <%+ cta %>
    </td>
  </tr>
</table>
