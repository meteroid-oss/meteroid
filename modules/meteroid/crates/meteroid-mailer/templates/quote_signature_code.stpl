<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <h1 class="h1" style="margin:0;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-0.3px;color:#111318;"><%= heading %></h1>
    </td>
  </tr>
  <tr>
    <td style="padding-top:16px;font-size:15px;line-height:24px;color:#414651;"><%= intro %></td>
  </tr>
  <tr>
    <td style="padding-top:24px;">
      <div class="code" style="display:inline-block;padding:12px 20px;border-radius:8px;background:#f3f4f6;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:28px;line-height:36px;letter-spacing:6px;font-weight:600;color:#111318;"><%= code %></div>
    </td>
  </tr>
  <tr>
    <td style="padding-top:24px;font-size:13px;line-height:20px;color:#6b7280;"><%= ignore %></td>
  </tr>
</table>
