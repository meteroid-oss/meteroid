<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <h1 class="h1" style="margin:0;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-0.3px;color:#111318;">You've been invited to join <%= org_name %></h1>
      <p style="margin:12px 0 0;font-size:15px;line-height:24px;color:#414651;"><%= inviter_name %> has invited you to join <strong style="color:#111318;"><%= org_name %></strong> as <strong style="color:#111318;"><%= role %></strong>.</p>
    </td>
  </tr>
  <tr>
    <td style="padding-top:28px;">
      <table role="presentation" class="btn" cellpadding="0" cellspacing="0" border="0">
        <tr>
          <td class="button" align="center" bgcolor="#111318" style="border-radius:8px;background-color:#111318;mso-padding-alt:12px 24px;">
            <a href="<%= invite_url %>" target="_blank" style="display:inline-block;padding:12px 24px;border-radius:8px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:15px;line-height:20px;font-weight:600;color:#ffffff;text-decoration:none;">Accept invitation</a>
          </td>
        </tr>
      </table>
    </td>
  </tr>
  <tr>
    <td style="padding-top:20px;">
      <p style="margin:0;font-size:13px;line-height:20px;color:#6b7079;">This invite expires in <%= expires_in %>.</p>
    </td>
  </tr>
  <tr>
    <td style="padding-top:8px;">
      <p style="margin:0;font-size:13px;line-height:20px;color:#6b7079;">Or copy and paste this link: <a href="<%= invite_url %>" target="_blank" style="color:#414651;text-decoration:underline;word-break:break-all;"><%= invite_url %></a></p>
    </td>
  </tr>
</table>
