<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <h1 class="h1" style="margin:0;font-size:24px;line-height:32px;font-weight:600;letter-spacing:-0.3px;color:#111318;"><%= heading %></h1>
      <p style="margin:8px 0 0;font-size:15px;line-height:24px;color:#414651;"><%= intro %></p>
    </td>
  </tr>
  <tr>
    <td style="padding-top:28px;">
      <%+ summary %>
    </td>
  </tr>
  <tr>
    <td style="padding-top:20px;">
      <p style="margin:0;font-size:14px;line-height:22px;color:#414651;"><%= note %></p>
    </td>
  </tr>
</table>
