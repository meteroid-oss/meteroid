---
source: modules/metric-core/src/sql/golden.rs
expression: d_single/no_window
---
WITH
    m_raw_sum AS (
        SELECT
            toDateTime(?{1767571200}) AS window_start,
            toDateTime(?{1769904000}) AS window_end,
            sum(toFloat64OrZero(properties[?{"tokens"}])) AS value
        FROM (
            SELECT id, customer_id, timestamp, ingested_at, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000}) AND properties[?{"tokens"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"tokens"}]))) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)))
        )
        ORDER BY
            window_start
    )
SELECT
    m_raw_sum.window_start AS window_start,
    m_raw_sum.window_end AS window_end,
    coalesce(m_raw_sum.value, 0) AS value
FROM m_raw_sum
ORDER BY
    window_start
