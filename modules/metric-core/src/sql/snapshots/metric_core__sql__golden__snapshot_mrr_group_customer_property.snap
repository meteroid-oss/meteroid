---
source: modules/metric-core/src/sql/golden.rs
expression: snapshot_mrr/group_customer_property
---
SELECT
    window_start,
    window_end,
    argMax(value, _snap_day) AS value,
    _prop_industry
FROM (
    SELECT
        toDateTime(tumbleStart(toDateTime(snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
        toDateTime(tumbleEnd(toDateTime(snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
        sum(toFloat64(mrr_cents_usd)) AS value,
        multiIf(JSONType(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"}) = 'String', JSONExtractString(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"}), JSONType(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"}) = 'Null', '(none)', JSONExtractRaw(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"})) AS _prop_industry,
        toDate(snapshot_date) AS _snap_day
    FROM fact_mrr_snapshot FINAL
    WHERE
        tenant_id = ?{11111111-1111-1111-1111-111111111111}
        AND toDateTime(snapshot_date) >= toDateTime(?{1767571200})
        AND toDateTime(snapshot_date) <= toDateTime(?{1769904000})
    GROUP BY
        toDateTime(tumbleStart(toDateTime(snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
        toDateTime(tumbleEnd(toDateTime(snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
        multiIf(JSONType(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"}) = 'String', JSONExtractString(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"}), JSONType(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"}) = 'Null', '(none)', JSONExtractRaw(dictGet('meteroid.dim_customer_dict', 'custom_properties', tuple(customer_id)), ?{"industry"})),
        toDate(snapshot_date)
)
GROUP BY
    window_start,
    window_end,
    _prop_industry
ORDER BY
    window_start
