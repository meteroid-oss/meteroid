---
source: modules/metric-core/src/sql/golden.rs
expression: fact_count/fx_eur_grouped
---
SELECT
    toDateTime(tumbleStart(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
    toDateTime(tumbleEnd(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
    toFloat64(count(*)) AS value,
    dictGet('meteroid.dim_customer_dict', 'country', tuple(customer_id)) AS _prop_country,
    dictGetOrDefault('meteroid.dim_plan_dict', 'name', tuple(ifNull(plan_id, toUUID('00000000-0000-0000-0000-000000000000'))), '(none)') AS _prop_plan,
    toString(ifNull(plan_id, toUUID('00000000-0000-0000-0000-000000000000'))) AS _dis_plan,
    movement_type AS _prop_movement_type
FROM fact_mrr_movement FINAL
WHERE
    tenant_id = ?{11111111-1111-1111-1111-111111111111}
    AND toDateTime(at) >= toDateTime(?{1767571200})
    AND toDateTime(at) <= toDateTime(?{1769904000})
    AND customer_id IN ?{["03030303-0303-0303-0303-030303030303"]}
GROUP BY
    toDateTime(tumbleStart(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
    toDateTime(tumbleEnd(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
    dictGet('meteroid.dim_customer_dict', 'country', tuple(customer_id)),
    ifNull(plan_id, toUUID('00000000-0000-0000-0000-000000000000')),
    movement_type
ORDER BY
    window_start
