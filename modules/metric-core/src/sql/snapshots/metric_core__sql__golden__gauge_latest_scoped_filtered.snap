---
source: modules/metric-core/src/sql/golden.rs
expression: gauge_latest/scoped_filtered
---
SELECT
    toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
    toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
    argMax(toFloat64OrZero(properties[?{"gb"}]), (timestamp, ingested_at, id)) AS value
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"storage"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000}) AND customer_id IN ?{["01010101-0101-0101-0101-010101010101", "02020202-0202-0202-0202-020202020202"]} AND (properties[?{"region"}] = ?{"eu"} OR properties[?{"region"}] = ?{"us"}) AND mapContains(properties, ?{"tier"}) AND properties[?{"tier"}] != ?{"free"} AND properties[?{"gb"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"gb"}]))) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('storage') AND customer_id IN (toUUID('01010101-0101-0101-0101-010101010101'), toUUID('02020202-0202-0202-0202-020202020202')) AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('storage') AND customer_id IN (toUUID('01010101-0101-0101-0101-010101010101'), toUUID('02020202-0202-0202-0202-020202020202')) AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)))
)
GROUP BY
    tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
    tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"})
ORDER BY
    window_start
