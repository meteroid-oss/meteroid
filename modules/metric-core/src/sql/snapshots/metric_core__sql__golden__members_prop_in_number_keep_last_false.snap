---
source: modules/metric-core/src/sql/golden.rs
expression: members prop_in_number keep_last=false
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                id AS customer_id
            FROM dim_customer FINAL
            WHERE
                tenant_id = ?{11111111-1111-1111-1111-111111111111}
                AND JSONHas(toString(custom_properties), ?{"seats"}) AND has(arrayMap(v -> toFloat64(v), ?{["1", "2"]}), JSONExtractFloat(toString(custom_properties), ?{"seats"}))
        ) AS p
    )
) AS members
