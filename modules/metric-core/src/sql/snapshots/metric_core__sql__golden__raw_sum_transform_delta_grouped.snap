---
source: modules/metric-core/src/sql/golden.rs
expression: raw_sum/transform_delta_grouped
---
SELECT
    window_start,
    window_end,
    value,
    _prop_region
FROM (
    SELECT
        window_start,
        window_end,
        value - lagInFrame(value, 1, 0) OVER (PARTITION BY _prop_region ORDER BY window_start ROWS BETWEEN 1 PRECEDING AND CURRENT ROW) AS value,
        _prop_region
    FROM (
        SELECT
            toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            sum(toFloat64OrZero(properties[?{"tokens"}])) AS value,
            properties[?{"region"}] AS _prop_region
        FROM (
            SELECT id, customer_id, timestamp, ingested_at, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767484800}) AND timestamp <= toDateTime(?{1769904000}) AND properties[?{"tokens"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"tokens"}]))) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767484800) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767484800) AND timestamp <= toDateTime(1769904000)))
        )
        GROUP BY
            tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            properties[?{"region"}]
        ORDER BY
            window_start
    )
)
WHERE
    window_start >= toDateTime(?{1767571200})
ORDER BY
    window_start
