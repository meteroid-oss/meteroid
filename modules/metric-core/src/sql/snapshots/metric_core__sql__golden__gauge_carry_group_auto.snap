---
source: modules/metric-core/src/sql/golden.rs
expression: gauge_carry/group_auto
---
SELECT
    window_start,
    window_end,
    coalesce(last_value(value) IGNORE NULLS OVER (PARTITION BY _prop_region ORDER BY window_start ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW), 0) AS value,
    _prop_region
FROM (
    SELECT
        window_start,
        window_end,
        value,
        _prop_region
    FROM (
        SELECT
            toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            argMax(toFloat64OrZero(properties[?{"gb"}]), (timestamp, ingested_at, id)) AS value,
            properties[?{"region"}] AS _prop_region
        FROM (
            SELECT id, customer_id, timestamp, ingested_at, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"storage"} AND timestamp >= toDateTime(?{0}) AND timestamp <= toDateTime(?{1769904000}) AND properties[?{"gb"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"gb"}]))) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('storage') AND timestamp >= toDateTime(0) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('storage') AND timestamp >= toDateTime(0) AND timestamp <= toDateTime(1769904000)))
        )
        GROUP BY
            tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            properties[?{"region"}]
        ORDER BY
            window_start
    )
)
WHERE
    window_start >= toDateTime(?{1767571200})
ORDER BY
    window_start
