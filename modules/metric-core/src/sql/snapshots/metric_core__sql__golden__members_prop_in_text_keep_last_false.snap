---
source: modules/metric-core/src/sql/golden.rs
expression: members prop_in_text keep_last=false
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                id AS customer_id
            FROM dim_customer FINAL
            WHERE
                tenant_id = ?{11111111-1111-1111-1111-111111111111}
                AND JSONExtractString(toString(custom_properties), ?{"seats"}) IN ?{["a", "b"]}
        ) AS p
    )
) AS members
