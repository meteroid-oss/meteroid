---
source: modules/metric-core/src/sql/golden.rs
expression: members two_predicates keep_last=false
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                id AS customer_id
            FROM dim_customer FINAL
            WHERE
                tenant_id = ?{11111111-1111-1111-1111-111111111111}
                AND country IN ?{["FR", "DE"]}
        ) AS p
    )
    INTERSECT
    (
        SELECT
            customer_id
        FROM (
            SELECT
                customer_id
            FROM (
                SELECT
                    subscription_id,
                    any(customer_id) AS customer_id,
                    argMax(plan_id, at) AS _plan,
                    argMaxIf(lifecycle_delta, at, lifecycle_delta != 0) AS _state
                FROM fact_subscription_event FINAL
                WHERE
                    tenant_id = ?{11111111-1111-1111-1111-111111111111}
                GROUP BY
                    subscription_id
            )
            WHERE
                _state = 1
                AND toString(_plan) IN ?{["p1", "p2"]}
        ) AS p
    )
) AS members
