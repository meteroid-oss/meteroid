---
source: modules/metric-core/src/sql/golden.rs
expression: tw_value/group_props
---
WITH
    params AS (
        SELECT
            toDateTime(?{1767571200}) AS window_start,
            toDateTime(?{1769904000}) AS window_end,
            toUUID(?{11111111-1111-1111-1111-111111111111}) AS param_tenant_id
    ),
    event_lifecycle AS (
        SELECT
            customer_id,
            tenant_id,
            properties['instance_id'] AS identity,
            timestamp AS start_time,
            leadInFrame(toNullable(timestamp)) OVER (PARTITION BY customer_id, tenant_id, properties['instance_id'] ORDER BY timestamp ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING) AS end_time,
            properties['zone'] AS _prop_zone,
            properties['az'] AS _prop_az,
            properties['vcpu'] AS weight_value
        FROM (
            SELECT id, customer_id, tenant_id, timestamp, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code IN ?{["vm_start", "vm_stop"]}) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('vm_start', 'vm_stop')) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('vm_start', 'vm_stop')))
        )
    ),
    instance_periods AS (
        SELECT
            el.customer_id,
            greatest(el.start_time, params.window_start) AS period_start,
            least(COALESCE(el.end_time, params.window_end), params.window_end) AS period_end,
            toFloat64OrZero(el.weight_value) AS w,
            el._prop_zone,
            el._prop_az
        FROM event_lifecycle AS el
        CROSS JOIN params
        WHERE
            el.tenant_id = params.param_tenant_id
            AND el.start_time < params.window_end
            AND (el.end_time > params.window_start OR el.end_time IS NULL)
    ),
    time_series AS (
        SELECT
            toDateTime(tumbleStart(toDateTime(params.window_start), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) + toIntervalDay(number) AS window_start,
            toDateTime(tumbleStart(toDateTime(params.window_start), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) + toIntervalDay(number + 1) AS window_end
        FROM params
        ARRAY JOIN range(toUInt32((toUnixTimestamp(params.window_end) - toUnixTimestamp(toDateTime(tumbleStart(toDateTime(params.window_start), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}))) / 86400) + 1) AS number
    )
SELECT
    ts.window_start AS window_start,
    ts.window_end AS window_end,
    sum(if(ip.period_start < ts.window_end AND ip.period_end > ts.window_start, dateDiff('second', greatest(ts.window_start, ip.period_start), least(ts.window_end, ip.period_end)) * ip.w, 0)) AS value,
    ip.customer_id AS customer_id,
    ip._prop_zone AS _prop_zone,
    ip._prop_az AS _prop_az
FROM time_series AS ts
CROSS JOIN instance_periods AS ip
WHERE
    ip.period_start < ts.window_end
    AND ip.period_end > ts.window_start
GROUP BY
    ts.window_start,
    ts.window_end,
    ip.customer_id,
    ip._prop_zone,
    ip._prop_az
ORDER BY
    window_start
