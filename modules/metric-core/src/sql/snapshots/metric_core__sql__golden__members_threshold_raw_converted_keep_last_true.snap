---
source: modules/metric-core/src/sql/golden.rs
expression: members threshold_raw_converted keep_last=true
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                customer_id
            FROM (
                SELECT id, customer_id, timestamp, ingested_at, properties
                FROM raw_events_v2
                WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000})) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000))) ORDER BY ingested_at DESC LIMIT 1 BY id, customer_id
            )
            GROUP BY
                customer_id
            HAVING
                sum(toFloat64OrZero(properties[?{"bytes"}])) / 1024 < 3
        ) AS p
    )
) AS members
