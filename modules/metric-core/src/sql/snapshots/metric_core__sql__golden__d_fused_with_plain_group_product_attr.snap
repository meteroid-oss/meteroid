---
source: modules/metric-core/src/sql/golden.rs
expression: d_fused_with_plain/group_product_attr
---
WITH
    m_fused_0 AS (
        SELECT
            toDateTime(tumbleStart(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            sumIf(toFloat64(delta_cents_usd), movement_type = ?{"churn"}) AS value_churn,
            sumIf(toFloat64(delta_cents_usd), movement_type = ?{"expansion"}) AS value_expansion,
            dictGetOrDefault('meteroid.dim_product_dict', 'name', tuple(ifNull(product_id, toUUID('00000000-0000-0000-0000-000000000000'))), '(none)') AS _prop_product,
            toString(ifNull(product_id, toUUID('00000000-0000-0000-0000-000000000000'))) AS _dis_product
        FROM fact_mrr_movement FINAL
        WHERE
            tenant_id = ?{11111111-1111-1111-1111-111111111111}
            AND toDateTime(at) >= toDateTime(?{1767571200})
            AND toDateTime(at) <= toDateTime(?{1769904000})
            AND (movement_type = ?{"churn"} OR movement_type = ?{"expansion"})
        GROUP BY
            toDateTime(tumbleStart(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
            toDateTime(tumbleEnd(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
            ifNull(product_id, toUUID('00000000-0000-0000-0000-000000000000'))
        ORDER BY
            window_start
    ),
    m_fact_sum AS (
        SELECT
            toDateTime(tumbleStart(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            sum(toFloat64(delta_cents_usd)) AS value,
            dictGetOrDefault('meteroid.dim_product_dict', 'name', tuple(ifNull(product_id, toUUID('00000000-0000-0000-0000-000000000000'))), '(none)') AS _prop_product,
            toString(ifNull(product_id, toUUID('00000000-0000-0000-0000-000000000000'))) AS _dis_product
        FROM fact_mrr_movement FINAL
        WHERE
            tenant_id = ?{11111111-1111-1111-1111-111111111111}
            AND toDateTime(at) >= toDateTime(?{1767571200})
            AND toDateTime(at) <= toDateTime(?{1769904000})
        GROUP BY
            toDateTime(tumbleStart(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
            toDateTime(tumbleEnd(toDateTime(at), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
            ifNull(product_id, toUUID('00000000-0000-0000-0000-000000000000'))
        ORDER BY
            window_start
    )
SELECT
    coalesce(m_fused_0.window_start, m_fact_sum.window_start) AS window_start,
    coalesce(m_fused_0.window_end, m_fact_sum.window_end) AS window_end,
    coalesce(m_fused_0.value_churn, 0) + coalesce(m_fused_0.value_expansion, 0) - coalesce(m_fact_sum.value, 0) AS value,
    coalesce(m_fused_0._prop_product, m_fact_sum._prop_product) AS _prop_product
FROM m_fused_0
FULL OUTER JOIN m_fact_sum ON m_fused_0.window_start = m_fact_sum.window_start AND m_fused_0.window_end = m_fact_sum.window_end AND m_fused_0._prop_product = m_fact_sum._prop_product
ORDER BY
    window_start
SETTINGS join_use_nulls = 1
