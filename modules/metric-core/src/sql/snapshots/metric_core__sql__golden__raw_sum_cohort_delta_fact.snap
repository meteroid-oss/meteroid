---
source: modules/metric-core/src/sql/golden.rs
expression: raw_sum/cohort_delta_fact
---
SELECT
    toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
    toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
    sum(toFloat64OrZero(properties[?{"tokens"}])) AS value
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000}) AND properties[?{"tokens"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"tokens"}])) AND customer_id IN (
        (
            SELECT
                customer_id
            FROM (
                SELECT
                    customer_id AS customer_id,
                    toFloat64(uniqIf(delta_cents_usd, toDateTime(at) >= toDateTime(?{1767571200}))) AS cur,
                    toFloat64(uniqIf(delta_cents_usd, toDateTime(at) < toDateTime(?{1767571200}) AND toDateTime(at) >= toDateTime(?{1765238400}))) AS prior
                FROM fact_mrr_movement FINAL
                WHERE
                    tenant_id = ?{11111111-1111-1111-1111-111111111111}
                    AND toDateTime(at) >= toDateTime(?{1765238400})
                    AND toDateTime(at) <= toDateTime(?{1769904000})
                GROUP BY
                    customer_id
                HAVING
                    prior != 0
                    AND (cur - prior) / prior * 100 > 12.5
            ) AS d
        )
    )) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)))
)
GROUP BY
    tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
    tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"})
ORDER BY
    window_start
