---
source: modules/metric-core/src/sql/golden.rs
expression: members inactive_fact keep_last=true
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                id AS customer_id
            FROM dim_customer FINAL
            WHERE
                tenant_id = ?{11111111-1111-1111-1111-111111111111}
                AND id NOT IN (
                    SELECT
                        customer_id AS customer_id
                    FROM fact_mrr_movement FINAL
                    WHERE
                        tenant_id = ?{11111111-1111-1111-1111-111111111111}
                        AND toDateTime(at) >= toDateTime(?{1767571200})
                        AND toDateTime(at) <= toDateTime(?{1769904000})
                    GROUP BY
                        customer_id
                    HAVING
                        uniq(delta_cents_usd) > 2
                )
        ) AS p
    )
) AS members
