---
source: modules/metric-core/src/sql/golden.rs
expression: members prop_between keep_last=false
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                id AS customer_id
            FROM dim_customer FINAL
            WHERE
                tenant_id = ?{11111111-1111-1111-1111-111111111111}
                AND JSONHas(toString(custom_properties), ?{"seats"}) AND JSONExtractFloat(toString(custom_properties), ?{"seats"}) >= toFloat64(?{"1"}) AND JSONExtractFloat(toString(custom_properties), ?{"seats"}) <= toFloat64(?{"9"})
        ) AS p
    )
) AS members
