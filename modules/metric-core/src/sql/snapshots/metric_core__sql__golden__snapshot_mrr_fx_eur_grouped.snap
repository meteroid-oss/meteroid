---
source: modules/metric-core/src/sql/golden.rs
expression: snapshot_mrr/fx_eur_grouped
---
SELECT
    window_start,
    window_end,
    argMax(value, _snap_day) AS value,
    _prop_country,
    _prop_plan,
    _dis_plan,
    _prop_movement_type
FROM (
    SELECT
        toDateTime(tumbleStart(toDateTime(f.snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
        toDateTime(tumbleEnd(toDateTime(f.snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
        sum(if(f.currency = f.fx_currency, toFloat64(f.mrr_cents), toFloat64(f.mrr_cents_usd) * fx.rate_from_usd)) AS value,
        dictGet('meteroid.dim_customer_dict', 'country', tuple(f.customer_id)) AS _prop_country,
        dictGetOrDefault('meteroid.dim_plan_dict', 'name', tuple(ifNull(f.plan_id, toUUID('00000000-0000-0000-0000-000000000000'))), '(none)') AS _prop_plan,
        toString(ifNull(f.plan_id, toUUID('00000000-0000-0000-0000-000000000000'))) AS _dis_plan,
        f.movement_type AS _prop_movement_type,
        toDate(f.snapshot_date) AS _snap_day
    FROM (
        SELECT
            mrr_cents_usd,
            mrr_cents,
            currency,
            snapshot_date,
            customer_id,
            plan_id,
            movement_type,
            toLowCardinality(?{"EUR"}) AS fx_currency
        FROM fact_mrr_snapshot FINAL
        WHERE
            tenant_id = ?{11111111-1111-1111-1111-111111111111}
            AND toDateTime(snapshot_date) >= toDateTime(?{1767571200})
            AND toDateTime(snapshot_date) <= toDateTime(?{1769904000})
            AND customer_id IN ?{["03030303-0303-0303-0303-030303030303"]}
    ) AS f
    ASOF LEFT JOIN (
        SELECT
            currency,
            date,
            rate_from_usd
        FROM dim_fx_rate FINAL
        WHERE
            currency = ?{"EUR"}
            AND date <= toDate(toDateTime(?{1769904000}))
    ) AS fx ON f.fx_currency = fx.currency AND fx.date <= toDate(f.snapshot_date)
    GROUP BY
        toDateTime(tumbleStart(toDateTime(f.snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
        toDateTime(tumbleEnd(toDateTime(f.snapshot_date), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}),
        dictGet('meteroid.dim_customer_dict', 'country', tuple(f.customer_id)),
        ifNull(f.plan_id, toUUID('00000000-0000-0000-0000-000000000000')),
        f.movement_type,
        toDate(f.snapshot_date)
)
GROUP BY
    window_start,
    window_end,
    _prop_country,
    _prop_plan,
    _dis_plan,
    _prop_movement_type
ORDER BY
    window_start
