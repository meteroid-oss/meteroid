---
source: modules/metric-core/src/sql/golden.rs
expression: d_arith/day
---
WITH
    m_raw_sum AS (
        SELECT
            toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            sum(toFloat64OrZero(properties[?{"tokens"}])) AS value
        FROM (
            SELECT id, customer_id, timestamp, ingested_at, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000}) AND properties[?{"tokens"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"tokens"}]))) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)))
        )
        GROUP BY
            tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"})
        ORDER BY
            window_start
    ),
    m_raw_count AS (
        SELECT
            toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            toFloat64(count(*)) AS value
        FROM (
            SELECT id, customer_id, timestamp, ingested_at, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000})) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)))
        )
        GROUP BY
            tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"})
        ORDER BY
            window_start
    ),
    m_raw_avg AS (
        SELECT
            toDateTime(tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_start,
            toDateTime(tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}), ?{"UTC"}) AS window_end,
            avg(toFloat64OrZero(properties[?{"tokens"}])) AS value
        FROM (
            SELECT id, customer_id, timestamp, ingested_at, properties
            FROM raw_events_v2
            WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1767571200}) AND timestamp <= toDateTime(?{1769904000}) AND properties[?{"tokens"}] != '' AND isNotNull(toFloat64OrNull(properties[?{"tokens"}]))) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1767571200) AND timestamp <= toDateTime(1769904000)))
        )
        GROUP BY
            tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
            tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"})
        ORDER BY
            window_start
    )
SELECT
    coalesce(m_raw_sum.window_start, m_raw_count.window_start, m_raw_avg.window_start) AS window_start,
    coalesce(m_raw_sum.window_end, m_raw_count.window_end, m_raw_avg.window_end) AS window_end,
    (coalesce(m_raw_sum.value, 0) + coalesce(m_raw_count.value, 0)) * (2.5 - coalesce(m_raw_avg.value, 0)) AS value
FROM m_raw_sum
FULL OUTER JOIN m_raw_count ON m_raw_sum.window_start = m_raw_count.window_start AND m_raw_sum.window_end = m_raw_count.window_end
FULL OUTER JOIN m_raw_avg ON coalesce(m_raw_sum.window_start, m_raw_count.window_start) = m_raw_avg.window_start AND coalesce(m_raw_sum.window_end, m_raw_count.window_end) = m_raw_avg.window_end
ORDER BY
    window_start
SETTINGS join_use_nulls = 1
