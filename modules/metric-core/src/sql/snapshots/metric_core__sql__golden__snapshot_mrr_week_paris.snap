---
source: modules/metric-core/src/sql/golden.rs
expression: snapshot_mrr/week_paris
---
SELECT
    window_start,
    window_end,
    argMax(value, _snap_day) AS value
FROM (
    SELECT
        toDateTime(tumbleStart(toDateTime(snapshot_date), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}) AS window_start,
        toDateTime(tumbleEnd(toDateTime(snapshot_date), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}) AS window_end,
        sum(toFloat64(mrr_cents_usd)) AS value,
        toDate(snapshot_date) AS _snap_day
    FROM fact_mrr_snapshot FINAL
    WHERE
        tenant_id = ?{11111111-1111-1111-1111-111111111111}
        AND toDateTime(snapshot_date) >= toDateTime(?{1767571200})
        AND toDateTime(snapshot_date) <= toDateTime(?{1769904000})
    GROUP BY
        toDateTime(tumbleStart(toDateTime(snapshot_date), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}),
        toDateTime(tumbleEnd(toDateTime(snapshot_date), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}),
        toDate(snapshot_date)
)
GROUP BY
    window_start,
    window_end
ORDER BY
    window_start
