---
source: modules/metric-core/src/sql/golden.rs
expression: fact_sum/week_paris
---
SELECT
    toDateTime(tumbleStart(toDateTime(at), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}) AS window_start,
    toDateTime(tumbleEnd(toDateTime(at), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}) AS window_end,
    sum(toFloat64(delta_cents_usd)) AS value
FROM fact_mrr_movement FINAL
WHERE
    tenant_id = ?{11111111-1111-1111-1111-111111111111}
    AND toDateTime(at) >= toDateTime(?{1767571200})
    AND toDateTime(at) <= toDateTime(?{1769904000})
GROUP BY
    toDateTime(tumbleStart(toDateTime(at), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"}),
    toDateTime(tumbleEnd(toDateTime(at), toIntervalWeek(1), ?{"Europe/Paris"}), ?{"Europe/Paris"})
ORDER BY
    window_start
