---
source: modules/metric-core/src/sql/golden.rs
expression: members delta_raw keep_last=false
---
SELECT DISTINCT
    customer_id
FROM (
    (
        SELECT
            customer_id
        FROM (
            SELECT
                customer_id
            FROM (
                SELECT
                    customer_id,
                    toFloat64(argMaxIf(toFloat64OrZero(properties[?{"tokens"}]), (timestamp, ingested_at, id), timestamp >= toDateTime(?{1767571200}))) AS cur,
                    toFloat64(argMaxIf(toFloat64OrZero(properties[?{"tokens"}]), (timestamp, ingested_at, id), timestamp < toDateTime(?{1767571200}) AND timestamp >= toDateTime(?{1765238400}))) AS prior
                FROM (
                    SELECT id, customer_id, timestamp, ingested_at, properties
                    FROM raw_events_v2
                    WHERE (tenant_id = ?{11111111-1111-1111-1111-111111111111} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1765238400}) AND timestamp <= toDateTime(?{1769904000})) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1765238400) AND timestamp <= toDateTime(1769904000)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('11111111-1111-1111-1111-111111111111') AND code IN ('api_call') AND timestamp >= toDateTime(1765238400) AND timestamp <= toDateTime(1769904000)))
                )
                GROUP BY
                    customer_id
                HAVING
                    prior != 0
                    AND (cur - prior) / prior * 100 <= -30
            ) AS d
        ) AS p
    )
) AS members
