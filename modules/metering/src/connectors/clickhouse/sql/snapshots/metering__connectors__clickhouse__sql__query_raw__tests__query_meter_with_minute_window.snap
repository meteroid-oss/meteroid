---
source: modules/metering/src/connectors/clickhouse/sql/query_raw.rs
expression: pretty
---
SELECT
    tumbleStart(toDateTime(timestamp), toIntervalMinute(1), ?{"UTC"}) AS window_start,
    tumbleEnd(toDateTime(timestamp), toIntervalMinute(1), ?{"UTC"}) AS window_end,
    toString(sum(ifNull(toDecimal128OrNull(properties[?{"amount"}], 9), accurateCastOrNull(toFloat64OrNull(properties[?{"amount"}]), 'Decimal(38, 9)')))) AS value,
    toString(countIf(isNull(toDecimal128OrNull(properties[?{"amount"}], 9)))) AS decimal_fallbacks
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{ffffffff-ffff-ffff-ffff-ffffffffffff} AND code = ?{"test_event"} AND timestamp >= toDateTime(?{1704067200}) AND timestamp < toDateTime(?{1704153600}) AND properties[?{"amount"}] != '' AND abs(toFloat64OrNull(properties[?{"amount"}])) < 1e18) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('test_event') AND timestamp >= toDateTime(1704067200) AND timestamp <= toDateTime(1704153600)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('test_event') AND timestamp >= toDateTime(1704067200) AND timestamp <= toDateTime(1704153600)))
)
GROUP BY
    tumbleStart(toDateTime(timestamp), toIntervalMinute(1), ?{"UTC"}),
    tumbleEnd(toDateTime(timestamp), toIntervalMinute(1), ?{"UTC"})
ORDER BY
    window_start
