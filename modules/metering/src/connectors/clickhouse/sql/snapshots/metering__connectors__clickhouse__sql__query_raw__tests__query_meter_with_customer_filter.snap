---
source: modules/metering/src/connectors/clickhouse/sql/query_raw.rs
expression: pretty
---
SELECT
    tumbleStart(toDateTime(timestamp), toIntervalHour(1), ?{"UTC"}) AS window_start,
    tumbleEnd(toDateTime(timestamp), toIntervalHour(1), ?{"UTC"}) AS window_end,
    toString(sum(ifNull(toDecimal128OrNull(properties[?{"bytes"}], 9), accurateCastOrNull(toFloat64OrNull(properties[?{"bytes"}]), 'Decimal(38, 9)')))) AS value,
    toString(countIf(isNull(toDecimal128OrNull(properties[?{"bytes"}], 9)))) AS decimal_fallbacks,
    customer_id
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{ffffffff-ffff-ffff-ffff-ffffffffffff} AND code = ?{"usage"} AND timestamp >= toDateTime(?{1704067200}) AND customer_id IN ?{["00000000-0000-0000-0000-000000000001", "00000000-0000-0000-0000-000000000002"]} AND properties[?{"bytes"}] != '' AND abs(toFloat64OrNull(properties[?{"bytes"}])) < 1e18) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('usage') AND customer_id IN (toUUID('00000000-0000-0000-0000-000000000001'), toUUID('00000000-0000-0000-0000-000000000002')) AND timestamp >= toDateTime(1704067200)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('usage') AND customer_id IN (toUUID('00000000-0000-0000-0000-000000000001'), toUUID('00000000-0000-0000-0000-000000000002')) AND timestamp >= toDateTime(1704067200)))
)
GROUP BY
    tumbleStart(toDateTime(timestamp), toIntervalHour(1), ?{"UTC"}),
    tumbleEnd(toDateTime(timestamp), toIntervalHour(1), ?{"UTC"}),
    customer_id
ORDER BY
    window_start
