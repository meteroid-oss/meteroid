---
source: modules/metering/src/connectors/clickhouse/sql/query_raw.rs
expression: count_meter_sql(true).1
---
SELECT
    min(toDateTime(timestamp)) AS window_start,
    max(toDateTime(timestamp)) AS window_end,
    toString(count()) AS value
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{ffffffff-ffff-ffff-ffff-ffffffffffff} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1704067200}) AND timestamp < toDateTime(?{1704153600})) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('api_call') AND timestamp >= toDateTime(1704067200) AND timestamp <= toDateTime(1704153600)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('api_call') AND timestamp >= toDateTime(1704067200) AND timestamp <= toDateTime(1704153600))) ORDER BY ingested_at DESC LIMIT 1 BY id, customer_id
)
