---
source: modules/metering/src/connectors/clickhouse/sql/query_raw.rs
expression: pretty
---
SELECT
    min(toDateTime(timestamp)) AS window_start,
    max(toDateTime(timestamp)) AS window_end,
    argMax(tuple(properties[?{"count"}], toString(ifNull(toDecimal128OrNull(properties[?{"count"}], 9), accurateCastOrNull(toFloat64OrNull(properties[?{"count"}]), 'Decimal(38, 9)')))), toFloat64OrNull(properties[?{"count"}])) AS _winner,
    _winner.1 AS value_raw,
    _winner.2 AS value,
    toString(countIf(isNull(toDecimal128OrNull(properties[?{"count"}], 9)))) AS decimal_fallbacks,
    customer_id
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{ffffffff-ffff-ffff-ffff-ffffffffffff} AND code = ?{"usage"} AND timestamp >= toDateTime(?{1704067200}) AND customer_id IN ?{["00000000-0000-0000-0000-000000000001"]} AND (properties[?{"product"}] = ?{"prod1"} AND properties[?{"version"}] IN ?{["v1"]}) AND properties[?{"count"}] != '' AND abs(toFloat64OrNull(properties[?{"count"}])) < 1e18) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('usage') AND customer_id IN (toUUID('00000000-0000-0000-0000-000000000001')) AND timestamp >= toDateTime(1704067200)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('usage') AND customer_id IN (toUUID('00000000-0000-0000-0000-000000000001')) AND timestamp >= toDateTime(1704067200)))
)
GROUP BY
    customer_id
