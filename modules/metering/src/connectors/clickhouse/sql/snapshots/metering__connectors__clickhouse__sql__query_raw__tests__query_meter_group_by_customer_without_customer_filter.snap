---
source: modules/metering/src/connectors/clickhouse/sql/query_raw.rs
expression: pretty
---
SELECT
    tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}) AS window_start,
    tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}) AS window_end,
    toString(count()) AS value,
    customer_id,
    properties[?{"region"}] AS _prop_region
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{ffffffff-ffff-ffff-ffff-ffffffffffff} AND code = ?{"api_call"} AND timestamp >= toDateTime(?{1704067200}) AND timestamp < toDateTime(?{1706745600})) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('api_call') AND timestamp >= toDateTime(1704067200) AND timestamp <= toDateTime(1706745600)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('api_call') AND timestamp >= toDateTime(1704067200) AND timestamp <= toDateTime(1706745600)))
)
GROUP BY
    tumbleStart(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
    tumbleEnd(toDateTime(timestamp), toIntervalDay(1), ?{"UTC"}),
    customer_id,
    properties[?{"region"}]
ORDER BY
    window_start
