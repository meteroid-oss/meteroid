---
source: modules/metering/src/connectors/clickhouse/sql/query_raw.rs
expression: pretty
---
SELECT
    min(toDateTime(timestamp)) AS window_start,
    max(toDateTime(timestamp)) AS window_end,
    toString(sum(ifNull(toDecimal128OrNull(properties[?{"bytes"}], 9), accurateCastOrNull(toFloat64OrNull(properties[?{"bytes"}]), 'Decimal(38, 9)')))) AS value,
    toString(countIf(isNull(toDecimal128OrNull(properties[?{"bytes"}], 9)))) AS decimal_fallbacks,
    properties[?{"customer_id"}] AS _prop_customer_id
FROM (
    SELECT id, customer_id, timestamp, ingested_at, properties
    FROM raw_events_v2
    WHERE (tenant_id = ?{ffffffff-ffff-ffff-ffff-ffffffffffff} AND code = ?{"usage"} AND timestamp >= toDateTime(?{1704067200}) AND (properties[?{"customer_id"}] = ?{"cust1"} OR properties[?{"customer_id"}] = ?{"cust2"}) AND properties[?{"bytes"}] != '' AND abs(toFloat64OrNull(properties[?{"bytes"}])) < 1e18) AND is_tombstone = 0 AND ((SELECT count() FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('usage') AND timestamp >= toDateTime(1704067200)) = 0 OR (customer_id, id, ingested_at) NOT IN (SELECT customer_id, id, ingested_at FROM meteroid.event_voids_local WHERE tenant_id = toUUID('ffffffff-ffff-ffff-ffff-ffffffffffff') AND code IN ('usage') AND timestamp >= toDateTime(1704067200)))
)
GROUP BY
    properties[?{"customer_id"}]
