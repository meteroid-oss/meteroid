## PLATFORM SECRETS
JWT_SECRET=changeMeSecret
INTERNAL_API_SECRET=changeMeSecret
# needs to be 32 characters long
SECRETS_CRYPT_KEY=00000000000000000000000000000000

## Billing
METEROID_API_LISTEN_ADDRESS=0.0.0.0:50061
METEROID_API_EXTERNAL_URL=http://127.0.0.1:50061
METEROID_REST_API_LISTEN_ADDRESS=0.0.0.0:8084
METEROID_REST_API_EXTERNAL_URL=http://127.0.0.1:8084
# Public base for inbound provider webhooks (Mollie). Unset = the REST URL above;
# set it (e.g. to a tunnel) when the REST URL must stay local for OAuth callbacks.
# METEROID_WEBHOOK_EXTERNAL_URL=https://<public-tunnel>
OPENEXCHANGERATES_API_KEY=

## Metering
METERING_API_LISTEN_ADDRESS=0.0.0.0:50062
METERING_API_EXTERNAL_URL=http://127.0.0.1:50062
KAFKA_RAW_TOPIC=meteroid-events-raw

## Database (postgres)
DATABASE_USER=meteroid
DATABASE_PASSWORD=secret
DATABASE_NAME=meteroid
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@localhost:5432/${DATABASE_NAME}?sslmode=disable

## Redis (optional, state shared across replicas)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

## Web front
VITE_METEROID_API_EXTERNAL_URL=${METEROID_API_EXTERNAL_URL}
VITE_METEROID_REST_API_EXTERNAL_URL=${METEROID_REST_API_EXTERNAL_URL}

## Kafka
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SASL_JAAS_CONFIG=
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=

## Clickhouse
CLICKHOUSE_DATABASE=meteroid
CLICKHOUSE_HTTP_ADDRESS=http://127.0.0.1:8123
# metering consumer insert_quorum: auto = majority; 1 resumes writes during a replica outage (ADR-0011)
#CLICKHOUSE_CONSUMER_INSERT_QUORUM=auto
CLICKHOUSE_TCP_ADDRESS=127.0.0.1:9000
CLICKHOUSE_USERNAME=default
CLICKHOUSE_PASSWORD=default

## Telemetry related
TELEMETRY_TRACING_ENABLED=false
TELEMETRY_METRICS_ENABLED=false
TELEMETRY_OTEL_ENDPOINT=http://localhost:4317


## Development only
DEBUG=false


# Use filesystem-based object store
OBJECT_STORE_URI=file:///tmp/meteroid/object-store

# Use S3-based object store (works with MinIO and AWS S3, and requires setting the envs for aws auth key chain correctly)
# OBJECT_STORE_URI=s3://meteroid
# AWS_ALLOW_HTTP=true
# AWS_ENDPOINT=http://localhost:9002
# AWS_ACCESS_KEY_ID=meteroid
# AWS_SECRET_ACCESS_KEY=meteroid



## Outbound webhooks
# WEBHOOK_DELIVERY_CONCURRENCY=32
# CONNECT egress proxy webhook and alert traffic is sent through (e.g. for fixed IPs).
# While it is down, deliveries wait without counting against their endpoints.
# WEBHOOK_EGRESS_PROXY_URL=
# Also send SSO through it; off so logins never depend on the proxy.
# EGRESS_USE_PROXY_SSO=false
# Minimum 2 (a delivery's retry ladder spans about 28 hours).
# WEBHOOK_RETENTION_DAYS=30

## Mailer
MAILER_SMTP_HOST=
MAILER_SMTP_USERNAME=
MAILER_SMTP_PASSWORD=
MAILER_SMTP_TLS=false
# Sender of account and alert emails; required once MAILER_SMTP_HOST is set.
MAILER_FROM="Meteroid <hey@example.com>"
# Address customer emails are sent from, behind each invoicing entity's sender name.
# Defaults to the address of MAILER_FROM.
# MAILER_CUSTOMER_FROM_ADDR=billing@example.com
# Reply-To of account and alert emails; none by default.
# MAILER_REPLY_TO="No Reply <no-reply@example.com>"

METEROID_PUBLIC_URL=http://localhost:5173

# METEROID_MFA_ISSUER=Meteroid

## Oauth
OAUTH_GOOGLE_CLIENT_ID=changeMeSecret
OAUTH_GOOGLE_CLIENT_SECRET=changeMeSecret

OAUTH_HUBSPOT_CLIENT_ID=changeMeSecret
OAUTH_HUBSPOT_CLIENT_SECRET=changeMeSecret

OAUTH_PENNYLANE_CLIENT_ID=changeMeSecret
OAUTH_PENNYLANE_CLIENT_SECRET=changeMeSecret

# ADMIN_ORGANIZATION_ID=

## Instance bootstrap (opt-in: docker-compose / CI)
# Creates a user, organization, Development tenant and API key at startup, then writes a
# dotenv fragment to source. Re-running converges on the same objects and re-emits the
# credentials. Everything below is ignored while ENABLED is false.
#
# For a FRESH instance. On an instance that already has an organization, and with
# ENABLE_MULTI_ORGANIZATION=false, the bootstrap logs a warning and stands down rather than
# taking over. An email that already has an account is adopted as is: the password below is
# NOT applied to it.
# INSTANCE_BOOTSTRAP_ENABLED=false
# INSTANCE_BOOTSTRAP_EMAIL=admin@example.com
# INSTANCE_BOOTSTRAP_PASSWORD=changeMeSecret
# INSTANCE_BOOTSTRAP_ORGANIZATION=Meteroid
# INSTANCE_BOOTSTRAP_TENANT=Development
# INSTANCE_BOOTSTRAP_COUNTRY=US
# INSTANCE_BOOTSTRAP_CURRENCY=USD
# Pin a key you already hold, so .env can carry it and nothing has to be captured; unset mints
# a new one on every boot (the stored hash can't be read back).
# Format: pv_<env>_<secret>/<id>
#   <env>    the tenant's environment: dev for the default Development tenant
#   <secret> at least 28 ASCII alphanumeric characters (the width Meteroid mints)
#   <id>     any base62 string; it becomes the token id, so it must be unique
# Easiest: boot once without it and copy the minted METEROID_API_KEY here. Or write one, e.g.
#   echo "pv_dev_$(openssl rand -base64 48 | tr -dc A-Za-z0-9 | head -c 32)/$(openssl rand -hex 8 | tr -dc 0-9 | head -c 12)"
# INSTANCE_BOOTSTRAP_API_KEY=
# Where to write the credentials fragment (created 0600, parent directories included); unset
# or blank prints them to stdout instead.
# INSTANCE_BOOTSTRAP_OUTPUT_PATH=/tmp/meteroid/bootstrap.env
# Connect the Test gateway (mock) provider and claim the card + direct-debit rails. Only rails
# that are unset, or point at a deleted connector, are claimed.
# INSTANCE_BOOTSTRAP_TEST_GATEWAY=true
